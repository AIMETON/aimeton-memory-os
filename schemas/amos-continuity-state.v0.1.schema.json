{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AMOS Continuity Mission State v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mission_id","objective","status","scope","active_critical_path","decisions","constraints","invariants",
    "attempted","rejected","failed","completed","open","blockers","next_safe_action","next_after_next",
    "authority_envelope","budget_envelope","exact_references","expected_evidence_digests","snapshot_id",
    "state_as_of","termination_criteria"
  ],
  "properties": {
    "mission_id": {"type":"string","minLength":1},
    "objective": {"type":"string","minLength":1},
    "status": {"enum":["ACTIVE","BLOCKED","COMPLETED"]},
    "scope": {"type":"string","minLength":1},
    "active_critical_path": {"type":"string","minLength":1},
    "decisions": {"type":"array"},
    "constraints": {"type":"array"},
    "invariants": {"type":"array"},
    "attempted": {"type":"array"},
    "rejected": {"type":"array"},
    "failed": {"type":"array"},
    "completed": {"type":"array"},
    "open": {"type":"array"},
    "blockers": {"type":"array"},
    "next_safe_action": {"$ref":"#/$defs/action"},
    "next_after_next": {"$ref":"#/$defs/action"},
    "authority_envelope": {"type":"object"},
    "budget_envelope": {"type":"object"},
    "exact_references": {"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
    "expected_evidence_digests": {"type":"object","additionalProperties":{"type":"string","pattern":"^[0-9a-f]{64}$"}},
    "snapshot_id": {"type":"string","pattern":"^amos:"},
    "state_as_of": {"type":"string","format":"date-time"},
    "termination_criteria": {"type":"array","minItems":1}
  },
  "$defs": {
    "action": {
      "type":"object",
      "additionalProperties": false,
      "required":["action_id","scope","description"],
      "properties":{
        "action_id":{"type":"string","minLength":1},
        "scope":{"type":"string","minLength":1},
        "description":{"type":"string","minLength":1}
      }
    }
  }
}
